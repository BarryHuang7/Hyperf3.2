XDEBUG_MODE=off
APP_DEBUG=false
APP_NAME=Ju
APP_ENV=development
APP_KEY=
APP_CIPHER=AES-256-CBC

DB_DRIVER=mysql
DB_HOST=host.docker.internal
DB_PORT=3306
DB_DATABASE=hyperf
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_PREFIX=ju_

REDIS_HOST=host.docker.internal
REDIS_AUTH=(null)
REDIS_PORT=6379
REDIS_DB=0

AMQP_HOST=host.docker.internal
AMQP_PORT=5672
AMQP_USER=admin
AMQP_PASSWORD=
AMQP_VHOST=/

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=465
MAIL_ENCRYPTION=ssl
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=smtps
MAIL_SENDMAIL_PATH=
MAIL_LOG_GROUP=
MAIL_LOG_NAME=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Service
MAIL_MARKDOWN_THEME=

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

WAVESPEED_WEBHOOK_SECRET=

REG_QUERY_URL=
REG_QUERY_DURATION_FIELD=duration
